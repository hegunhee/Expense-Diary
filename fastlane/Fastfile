default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

def load_version_and_changelog
  pubspec_content = File.read("../pubspec.yaml")
  version_match = pubspec_content.match(/^\s*version:\s*([^\s#]+)/)
  UI.user_error!("pubspec.yaml에서 version 값을 찾을 수 없습니다.") unless version_match
  version = version_match[1].strip
  version_name = version.split('+', 2).first
  version_code = version.split('+', 2).last
  
  release_note_path = "../docs/releaseNotes/#{version_name}.md"
  if File.exist?(release_note_path)
    changelog = File.read(release_note_path).strip
    UI.user_error!("릴리즈 노트가 비어 있습니다: #{release_note_path}") if changelog.empty?
    UI.message("릴리즈 노트 로드: #{release_note_path}")
  else
    UI.user_error!("릴리즈 노트를 찾을 수 없습니다: #{release_note_path}")
  end
  
  return version_name, version_code, changelog
end

platform :ios do
  desc "TestFlight에 업로드"
  lane :beta do
    version_name, version_code, changelog = load_version_and_changelog
    
    # App Store Connect API 인증
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # 코드 서명 설정 (수동)
    import_certificate(
      certificate_path: "distribution.p12",
      certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"],
      keychain_name: "build.keychain",
      keychain_password: "temp_password",
    )

    install_provisioning_profile(
      path: "profile.mobileprovision"
    )

    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["DEVELOPMENT_TEAM_ID"],
      bundle_identifier: "com.gunhee.expensediary",
      profile_name: ENV["PROVISIONING_PROFILE_NAME"],
      code_sign_identity: "Apple Distribution",
    )

    # Xcode 빌드 & 아카이브 (Flutter 빌드는 워크플로우에서 완료)
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build/ios",
    )

    # TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      changelog: changelog
    )
  end
end

platform :android do
  desc "Google Play Store에 업로드"
  lane :deploy do
    version_name, version_code, changelog = load_version_and_changelog
    
    # changelog 파일 생성
    changelog_dir = "metadata/android/ko-KR/changelogs"
    FileUtils.mkdir_p(changelog_dir)
    File.write("#{changelog_dir}/#{version_code}.txt", changelog)
    UI.message("Changelog 생성: #{changelog_dir}/#{version_code}.txt")
    
    # Google Play Store에 업로드 (internal 트랙)
    # AAB 파일은 워크플로우에서 이미 빌드됨
    upload_to_play_store(
      package_name: "blueberry.gunhee.expensediary",
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_STORE_CONFIG_JSON"],
      skip_upload_screenshots: true,
      skip_upload_images: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false
    )
  end
end
